generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String?
  isAdmin     Boolean   @default(false)
  avatarUrl   String?
  websiteUrl  String?
  createdAt   DateTime  @default(now())
  comments    Comment[]
  votes       Vote[]
}

model Page {
  id        String    @id @default(cuid())
  pageKey   String    @unique
  title     String?
  url       String?
  siteName  String    @default("default")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  raw       String
  pageKey   String
  siteName  String   @default("default")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  page      Page     @relation(fields: [pageKey], references: [pageKey])
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  rootId    String?
  depth     Int      @default(0)
  isPending  Boolean   @default(true)
  isPinned   Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  ipRegion   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  value     Int
  user      User     @relation(fields: [userId], references: [id])
  comment   Comment  @relation(fields: [commentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
}

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String
  timestamp DateTime @default(now())

  @@index([key, timestamp])
}
