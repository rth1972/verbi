# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Email notifications (leave SMTP_HOST blank to disable) ─
# Works with any SMTP provider: Gmail, Resend, Postmark, Mailgun, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   # use an App Password, not your account password
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Verbi Comments <no-reply@yourdomain.com>

# ── Site URL (used in email links) ────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
