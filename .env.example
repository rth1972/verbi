# ── Required: Admin Auth ──────────────────────────────────
JWT_SECRET=
VERBI_ADMIN_EMAIL=
VERBI_ADMIN_PASSWORD=
VERBI_ADMIN_NAME=Admin

# ── Email notifications (leave SMTP_HOST blank to disable) ─
# Works with any SMTP provider: Gmail, Resend, Postmark, Mailgun, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   # use an App Password, not your account password
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxx
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Verbi Comments <no-reply@yourdomain.com>

# ── Site URLs (used in notification links) ───────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERBI_SERVER_URL=http://localhost:3000

# ── Telegram notifications (leave blank to disable) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CSRF protection: comma-separated allowed origins ─────
# Leave blank to allow any origin (not recommended in production).
# Example: https://blog.example.com,https://verbi.example.com
VERBI_ALLOWED_ORIGINS=
